{
  "name": "nunchi-temperature-poll",
  "version": "1.0.0",
  "description": "A tiny anonymous hot/cold office temperature poll web app.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "reel:mobile": "node scripts/build-mobile-reel.mjs",
    "reel:capture": "node scripts/build-mobile-reel.mjs --capture-only",
    "reel:render": "node scripts/build-mobile-reel.mjs --render-only",
    "reel:thumbnail": "yarn remotion still reels/remotion/src/index.tsx NunchiReelThumbnail reels/outputs/nunchi-reel-thumbnail.png --overwrite --width 1080 --height 1920 --fps 30",
    "reel:thumbnail:bold": "yarn remotion still reels/remotion/src/index.tsx NunchiReelThumbnailBold reels/outputs/nunchi-reel-thumbnail-bold.png --overwrite --width 1080 --height 1920 --fps 30",
    "reel:thumbnail:minimal": "yarn remotion still reels/remotion/src/index.tsx NunchiReelThumbnailMinimal reels/outputs/nunchi-reel-thumbnail-minimal.png --overwrite --width 1080 --height 1920 --fps 30"
  },
  "keywords": [
    "temperature",
    "poll",
    "office",
    "comfort",
    "socket.io"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.276",
    "nodemon": "^3.1.4",
    "playwright": "^1.48.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.276"
  },
  "engines": {
    "node": ">=18"
  }
}
